DATABASE_URL='postgresql://user:password@localhost:5432/newsfoundry'
# Sans PostgreSQL (Docker) : mettre TEST_SQLITE=1 pour SQLite en memoire — l'API demarre sur :8000 quand meme.
# Les donnees sont perdues a l'arret du serveur ; DATABASE_URL est ignore dans ce mode.
# TEST_SQLITE='1'
# Dev PostgreSQL local : 1 pour créer test@test.com / test au démarrage. Ne pas activer en production (Railway).
SEED_DEFAULT_USER='1'
# 1 pour tracer les requêtes SQL dans les logs (bruyant en prod)
SQL_ECHO=''
JWT_SECRET='change-me-in-production'
JWT_EXPIRE_DAYS='7'
JWT_REFRESH_EXPIRE_DAYS='30'
# Mettre a 1 pour desactiver le rate limit (tests locaux / CI)
DISABLE_RATE_LIMIT=''
# Copier ce fichier en .env et renseigner les clés (ne jamais committer .env ni mettre de vraies clés ici).
WORLDNEWS_API_KEY=''
# Optionnel : pays / langue pour GET https://api.worldnewsapi.com/top-news (titres + résumés injectés dans le prompt figé par discussion)
WORLDNEWS_SOURCE_COUNTRY='fr'
WORLDNEWS_LANGUAGE='fr'
OPENAI_API_KEY=''
# Clé Google AI (Gemini) : utilisée pour les specs google-gla: / google-vertex: (PydanticAI).
GOOGLE_API_KEY=''
# Clé Mistral (La Plateforme) : utilisée si MISTRAL_MODEL est défini ou si OPENAI_MODEL=mistral:…
MISTRAL_API_KEY=''
# ID modèle Mistral seul (prioritaire sur GEMINI_MODEL et OPENAI_MODEL pour le chat).
# Ex. mistral-small-latest ; si HTTP 429 « service_tier_capacity_exceeded » (code 3505), essayez un autre modèle
# (ex. open-mistral-nemo-latest) ou patientez / montez de palier sur https://console.mistral.ai .
MISTRAL_MODEL=''
# Revue : forcer un modèle Mistral (sinon alignement sur MISTRAL_MODEL / GEMINI / OPENAI).
MISTRAL_REVIEW_MODEL=''
# Optionnel : ID Gemini seul (si MISTRAL_MODEL vide). Ex. gemini-1.5-flash
GEMINI_MODEL=''
# Modèle chat : openai:gpt-4o-mini | google-gla:gemini-1.5-flash | mistral:mistral-small-latest (sans suffixe -latest si besoin).
# Ordre de choix : MISTRAL_MODEL → GEMINI_MODEL → OPENAI_MODEL ; sinon défaut selon la clé (Google, Mistral, puis OpenAI).
OPENAI_MODEL='openai:gpt-4o-mini'
# Revue : id OpenAI seul (gpt-4o-mini) ou spec complète. GEMINI_REVIEW_MODEL force Gemini pour la revue.
GEMINI_REVIEW_MODEL=''
OPENAI_REVIEW_MODEL='gpt-4o-mini'
# Port HTTP uvicorn (défaut 8000). Ex. 8001 en local si le port 8000 est pris.
# PORT='8001'
# Origines CORS exactes, séparées par des virgules (obligatoire si le front est sur un domaine custom, pas *.vercel.app).
# Ex. https://www.mondomaine.com,https://mondomaine.com — en plus du regex Vercel intégré et de localhost.
CORS_ORIGINS=''
# 1 = autoriser toutes les origines (tests uniquement ; incompatible avec cookies cross-origin ; JWT Bearer OK).
# CORS_RELAXED=''
# Remplace entièrement la regex CORS par défaut (Vercel + dev local) si vous devez tout contrôler en une variable.
# CORS_ORIGIN_REGEX=''