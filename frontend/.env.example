# Copier en .env ou .env.local
#
# Option A — proxy (recommandé en local, même origine que le front) :
# NEXT_PUBLIC_API_URL=/api-backend
# BACKEND_PROXY_TARGET=http://127.0.0.1:8001
#
# Option B — URL absolue directe (doit correspondre au PORT du backend) :
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
